        },
        {
          "action": "click",
          "selector": "[data-newsch]",
          "as": "parent"
        },
        {
          "action": "waitFor",
          "selector": "#f-pattern",
          "as": "parent"
        },
        {
          "action": "expectText",
          "text": "Propose a custody schedule",
          "as": "parent"
        },
        {
          "action": "select",
          "selector": "#f-child",
          "value": "{{kid}}",
          "as": "parent"
        },
        {
          "action": "select",
          "selector": "#f-pattern",
          "value": "alternating_weeks",
          "as": "parent"
        },
        {
          "action": "fill",
          "selector": "#f-time",
          "value": "17:00",
          "as": "parent"
        },
        {
          "action": "click",
          "selector": "#save-sch",
          "as": "parent"
        },
        {
          "action": "waitFor",
          "selector": "[data-retiresch]",
          "as": "parent"
        },
        {
          "action": "dialog",
          "answer": "accept",
          "as": "parent"
        },
        {
          "action": "click",
          "selector": "[data-tab=\"handoffs\"]",
          "as": "parent"
        },
        {
          "action": "waitFor",
          "selector": "[data-testid=\"recent-exchanges\"]",
          "as": "parent"
        },
        {
          "action": "expectText",
          "text": "What actually happened",
          "as": "parent"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"exchange-record\"] [data-outcome$=\"exchange_as_planned\"]",
          "as": "parent"
        },
        {
          "action": "waitFor",
          "selector": "[data-testid=\"exchange-correct\"]",
          "as": "parent"
        },
        {
          "action": "expectText",
