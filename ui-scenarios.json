            "2026-01-01T00:00:00Z",
            "{{parent}}",
            "{{kid}}",
            "{{parent}}",
            "{{kid}}",
            "two_two_three",
            "[\"a\",\"a\",\"b\",\"b\",\"a\",\"a\",\"a\",\"b\",\"b\",\"a\",\"a\",\"b\",\"b\",\"b\"]",
            14,
            "2026-04-06",
            "18:30",
            "America/Denver",
            "moving closer to the school"
