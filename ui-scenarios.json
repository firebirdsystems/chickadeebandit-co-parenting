{
  "scenarios": [
    {
      "name": "a parent proposes a standing schedule and the agreed version drives the calendar",
      "members": {
        "parent": "adult",
        "kid": "child"
      },
      "steps": [
        {
          "action": "open",
          "as": "parent"
        },
        {
          "action": "click",
          "selector": "[data-tab=\"setup\"]",
          "as": "parent"
        },
        {
          "action": "expectText",
          "text": "The standing schedule is an agreement",
          "as": "parent"
        },
        {
          "action": "expectText",
          "text": "No schedules yet.",
          "as": "parent"
        },
        {
          "action": "click",
          "selector": "[data-newsch]",
          "as": "parent"
        },
        {
          "action": "waitFor",
          "selector": "#f-pattern",
          "as": "parent"
        },
        {
          "action": "expectText",
          "text": "Propose a custody schedule",
          "as": "parent"
        },
        {
          "action": "select",
          "selector": "#f-child",
          "value": "{{kid}}",
          "as": "parent"
        },
        {
          "action": "select",
          "selector": "#f-pattern",
          "value": "alternating_weeks",
          "as": "parent"
        },
        {
          "action": "fill",
          "selector": "#f-anchor",
          "value": "2026-03-02",
          "as": "parent"
        },
        {
          "action": "fill",
          "selector": "#f-time",
          "value": "17:00",
          "as": "parent"
        },
        {
          "action": "click",
          "selector": "#save-sch",
          "as": "parent"
        },
        {
          "action": "waitFor",
          "selector": "[data-retiresch]",
          "as": "parent"
        },
        {
          "action": "expectText",
          "text": "Alternating weeks",
          "as": "parent"
        },
        {
          "action": "expectText",
          "text": "on one parent's signature",
          "as": "parent"
        },
        {
          "action": "expectNoText",
          "text": "No schedules yet.",
          "as": "parent"
        },
        {
          "action": "reload",
          "as": "parent"
        },
        {
          "action": "waitFor",
          "selector": ".cal-grid",
          "as": "parent"
        },
        {
          "action": "expectVisible",
          "selector": ".cal-cell.today",
          "as": "parent"
        },
        {
          "action": "expectText",
          "text": "Alternating weeks",
          "as": "parent"
        }
      ]
    },
    {
      "name": "a pending amendment is never presented as the schedule",
