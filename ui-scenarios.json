    {
      "name": "a parent records an exchange, corrects it with a second entry, and both stay on the record",
      "members": {
        "parent": "adult",
        "kid": "child"
      },
      "steps": [
        {
          "action": "open",
          "as": "parent"
        },
        {
          "action": "click",
          "selector": "[data-tab=\"setup\"]",
          "as": "parent"
        },
        {
          "action": "expectText",
