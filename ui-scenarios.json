        },
        {
          "action": "open",
          "as": "parent"
        },
        {
          "action": "click",
          "selector": "[data-tab=\"setup\"]",
          "as": "parent"
        },
        {
          "action": "expectText",
          "text": "Change proposed",
          "as": "parent"
        },
        {
          "action": "expectText",
          "text": "moving closer to the school",
          "as": "parent"
        },
        {
          "action": "expectText",
          "text": "Waiting for your co-parent to countersign",
          "as": "parent"
