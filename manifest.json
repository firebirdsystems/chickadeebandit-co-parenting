          "query": "SELECT l.day AS day, l.child_id AS child, d.parent_id AS planned_with, l.parent_id AS recorded_with, l.created_by AS recorded_by, l.created_at AS recorded_at, l.note AS note FROM app_co_parenting__custody_log l LEFT JOIN app_co_parenting__custody_days d ON d.child_id = l.child_id AND d.day = l.day WHERE l.kind = 'child_with' AND l.day >= :range_start AND l.day <= :range_end ORDER BY l.day, l.child_id, l.created_at"
