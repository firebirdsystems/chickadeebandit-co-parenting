  "agenda": {
    "kind": "event",
    "label": "Custody",
    "source": {
      "kind": "sql",
      "query": "SELECT id AS id, title AS title, subtitle AS subtitle, day AS when_at, child_id AS member_id FROM app_co_parenting__custody_days WHERE day = :today ORDER BY is_transition DESC, id LIMIT 10"
    }
  },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT title AS title, subtitle AS subtitle, day AS at, child_id AS member_id FROM app_co_parenting__custody_days WHERE is_transition = 1 AND day >= :today ORDER BY day LIMIT 3"
    },
    "display": {
      "template": "list",
      "title": "title",
      "subtitle": "subtitle",
      "when": "at",
      "owner": "member_id"
    }
  },
  "reports": {
    "change_history": true,
    "views": [
      {
        "id": "custody_record",
        "title": "Custody record",
        "description": "Which parent each child was with, day by day, including exchanges.",
        "source": {
          "kind": "sql",
          "query": "SELECT day AS day, child_id AS child, parent_id AS parent, from_parent_id AS from_parent, source AS source, exchange_time AS exchange_time FROM app_co_parenting__custody_days WHERE day >= :range_start AND day <= :range_end ORDER BY day, child_id"
        },
        "columns": [
          {
            "key": "day",
            "label": "Date",
            "format": "date"
          },
          {
            "key": "child",
            "label": "Child",
            "format": "member"
          },
          {
            "key": "parent",
            "label": "With",
            "format": "member"
          },
          {
            "key": "from_parent",
            "label": "Exchanged from",
            "format": "member"
          },
          {
            "key": "exchange_time",
            "label": "Exchange time"
          },
          {
            "key": "source",
            "label": "Set by"
          }
        ]
      },
      {
        "id": "schedule_changes",
        "title": "Schedule changes",
        "description": "Every countersigned exception to the standing rotation, with the terms exactly as frozen when both parents agreed.",
        "source": {
          "kind": "sql",
          "query": "SELECT start_date AS start_date, end_date AS end_date, child_id AS child, to_parent_id AS parent, note AS reason, requester_id AS requested_by, locked_at AS locked_at FROM app_co_parenting__swap_agreements WHERE status = 'locked' AND start_date >= :range_start AND start_date <= :range_end ORDER BY start_date"
        },
        "columns": [
          {
            "key": "start_date",
            "label": "From",
            "format": "date"
          },
          {
            "key": "end_date",
            "label": "To",
            "format": "date"
          },
          {
            "key": "child",
            "label": "Child",
            "format": "member"
          },
          {
            "key": "parent",
            "label": "With",
            "format": "member"
          },
          {
            "key": "reason",
            "label": "Reason"
          },
          {
            "key": "requested_by",
            "label": "Requested by",
            "format": "member"
          },
          {
            "key": "locked_at",
            "label": "Countersigned",
