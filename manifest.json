      {
        "id": "swap_requests",
        "title": "Swap requests",
        "description": "Requested schedule changes and how each was answered. The outcome and terms are the countersigned agreement's wherever one exists (\"locked\" means both parents confirmed it), not the request's own editable copy.",
        "source": {
          "kind": "sql",
          "query": "SELECT r.created_at AS created_at, COALESCE(a.child_id, r.child_id) AS child, COALESCE(a.start_date, r.start_date) AS start_date, COALESCE(a.end_date, r.end_date) AS end_date, r.requester_id AS requester, r.responder_id AS responder, COALESCE(a.to_parent_id, r.to_parent_id) AS to_parent, COALESCE(a.status, r.status) AS status, COALESCE(a.note, r.note) AS note FROM app_co_parenting__swap_requests r LEFT JOIN app_co_parenting__swap_agreements a ON a.id = r.id WHERE r.created_at >= :range_start AND substr(r.created_at, 1, 10) <= substr(:range_end, 1, 10) ORDER BY r.created_at"
