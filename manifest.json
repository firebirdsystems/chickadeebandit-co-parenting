{
  "id": "co-parenting",
  "name": "Co-Parenting",
  "version": "1.7.0",
  "description": "Shared custody coordination for split households — per-child standing schedules (alternating weeks, 2-2-3, alternating weekends, 2-2-5-5, 3-4-4-3, or your own cycle) that take effect only when both parents countersign once both have joined (one set up before the other parent joins is in force on one signature and recorded that way), countersigned one-off swaps whose terms are frozen server-side at approval, and handoff notes. Every agreed version is kept; custody days are worked out on the server from what was agreed and flow to the household Calendar, so kids always know where they are.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "family",
  "tags": [
    "co-parenting",
    "custody",
    "schedule",
    "family"
  ],
  "data_access": {
    "reads": [
      "family.members",
      "family.preferences"
    ],
    "writes": []
  },
  "exports": [
    "calendar_events"
  ],
  "permissions": {
    "default_audience": "adults",
    "requires_approval": false
  },
  "contexts": [
    "household",
    "shared_space"
  ],
